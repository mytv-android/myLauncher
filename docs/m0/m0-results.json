    "4": {
      "title": "READ_TV_LISTINGS 的可见范围",
      "conclusion": "API 28/31/34/36 上第三方应用持 READ_TV_LISTINGS 能读到 dolphin+spark 的 3 个频道、10 个预览节目、3 个 Watch Next 行；带 selection 的查询全部抛 SecurityException。API 23 有 TvProvider authority 但没有 preview/watch-next 表，P02 跳过。",
      "data": {
        "devices": {
          "api23": {"otherSearchableRows": null, "selectionSecurityException": null, "tvProvider": true},
          "api28": {"otherSearchableRows": {"channels": 3, "preview_programs": 10, "watch_next_programs": 3}, "selectionSecurityException": true},
          "api31g": {"otherSearchableRows": {"channels": 3, "preview_programs": 10, "watch_next_programs": 3}, "selectionSecurityException": true},

    "5": {
      "title": "ACTION_REQUEST_CHANNEL_BROWSABLE 的接收者",
      "conclusion": "系统桌面仍安装时，API 26+ 的请求由系统推荐/桌面组件接管：AOSP ATV 为 tvrecommendations/.AddChannelActivity，Google TV 为 launcherx/.coreservices.localchannels.AddChannelActivity；API 23 没有处理者。桌面必须自己声明处理 Activity 并维护审批表。",
      "data": {
        "handlers": {
          "api23": [],
          "api28": ["com.google.android.tvrecommendations/.AddChannelActivity"],
          "api31g": ["com.google.android.apps.tv.launcherx/.coreservices.localchannels.AddChannelActivity"],
          "api34g": ["com.google.android.apps.tv.launcherx/.coreservices.localchannels.AddChannelActivity"],
          "api36": ["com.google.android.tvrecommendations/.AddChannelActivity"]
        }
      },
      "evidence": [
        "docs/m0/evidence/item05-browsable.md",
        "docs/m0/evidence/api23/P01-handlers.json",
        "docs/m0/evidence/api28/P01-handlers.json",

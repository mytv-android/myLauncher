        "docs/m0/evidence/api36/frozen.json",
        "docs/m0/evidence/api31g/frozen-t2.png"
      ]
    },
    "3": {
      "title": "PixelCopy 抓 SurfaceView",
      "conclusion": "API 28+ 的 SurfaceView 抓帧均成功：61ms（api28）、112ms（api31g）、492ms（api34g）、240ms（api36），画面亮度正常、无全黑。Window 级抓帧在四台设备上都返回全黑，说明 SurfaceView 内容不能靠窗口抓帧获得。API 23 没有 PixelCopy；矩阵没有 API 24/26；模拟器没有受保护内容，DRM 路径未测。",
      "data": {
        "devices": {
          "api23": {"skipped": "api<24"},
          "api28": {"surfaceMs": 61, "surfaceOk": true, "windowMs": 25, "windowBlackRatio": 1.0},
          "api31g": {"surfaceMs": 112, "surfaceOk": true, "windowMs": 144, "windowBlackRatio": 1.0},
          "api34g": {"surfaceMs": 492, "surfaceOk": true, "windowMs": 161, "windowBlackRatio": 1.0},
          "api36": {"surfaceMs": 240, "surfaceOk": true, "windowMs": 91, "windowBlackRatio": 1.0}
        },
        "drm": "not_tested"
      },

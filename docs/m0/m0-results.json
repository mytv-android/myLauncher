  "items": {
    "1": {
      "title": "Haze T1 帧时间",
      "conclusion": "T1 在 API 31+ 可运行，但五台模拟器都跑不到 60fps：api31g P50 50.01ms、api34g 83.34ms、api36 166.67ms（均为 3 次冷启动中位数）。五台 AVD 共用同一 x86 主机，不能替代设计要求的 3 种真实 SoC；这些数字是模拟器参考值，T1/T2/T3 的最终档位必须在真机复测。",
      "data": {
        "mediansMs": {
          "api23": {"t1": "skipped api<31", "t3": {"p50": 47.55, "p90": 61.08, "p99": 64.18}},
          "api28": {"t1": "skipped api<31", "t3": {"p50": 158.98, "p90": 159.04, "p99": 176.66}},
          "api31g": {"t1": {"p50": 50.01, "p90": 83.33, "p99": 100.0}, "t3": {"p50": 33.33, "p90": 33.34, "p99": 50.0}},
          "api34g": {"t1": {"p50": 83.34, "p90": 116.67, "p99": 150.01}, "t3": {"p50": 66.67, "p90": 99.99, "p99": 133.34}},
          "api36": {"t1": {"p50": 166.67, "p90": 233.33, "p99": 300.0}, "t3": {"p50": 50.0, "p90": 66.67, "p99": 83.33}}
        },
        "socCount": 1,
        "note": "所有 AVD 共用宿主 x86_64；不满足 3 种 SoC，需真机复测"
      },
      "evidence": [
        "docs/m0/evidence/item01-haze.json",
        "docs/m0/evidence/api23/haze-trials.jsonl",
        "docs/m0/evidence/api28/haze-trials.jsonl",
        "docs/m0/evidence/api31g/haze-trials.jsonl",
        "docs/m0/evidence/api34g/haze-trials.jsonl",
        "docs/m0/evidence/api36/haze-trials.jsonl",
        "docs/m0/evidence/api31g/haze-t1.png"
      ]
    },
    "2": {
      "title": "T2 冻结玻璃的对齐与换背景耗时",
      "conclusion": "按坐标取样的冻结位图方案在五台设备上对齐偏移均为 0px；生成一次 1280x720 模糊图耗时 54.9ms（api23）到 2005ms（api36），换背景耗时 29.5ms 到 1431ms。模拟器性能差异极大，真机需复测；T2 不依赖 RenderEffect，API 23 也能运行。",
      "data": {
        "devices": {
          "api23": {"generateMs": 54.88, "swapMs": 53.96, "alignmentOffsetPx": 0},
          "api28": {"generateMs": 58.14, "swapMs": 29.53, "alignmentOffsetPx": 0},
          "api31g": {"generateMs": 421.27, "swapMs": 35.94, "alignmentOffsetPx": 0},
          "api34g": {"generateMs": 830.4, "swapMs": 148.92, "alignmentOffsetPx": 0},
          "api36": {"generateMs": 2004.96, "swapMs": 1431.43, "alignmentOffsetPx": 0}
        }
      },
      "evidence": [
        "docs/m0/evidence/item02-frozen.json",
        "docs/m0/evidence/api23/frozen.json",
        "docs/m0/evidence/api28/frozen.json",

    "6": {
      "title": "小组件绑定与遥控器交互",
      "conclusion": "五台设备都没有 ACTION_APPWIDGET_BIND 处理者，但 appwidget grantbind 后第三方宿主可以直接绑定（P03 全部通过）。探针在 api31g 成功绑定 sky 天气小组件并收到 onUpdate。Shizuku 与常见手机小组件的电视布局未实测，留到 M3/真机。",
      "data": {
        "appwidgetBindHandler": false,
        "grantbindWorks": true,
        "selftestOnApi31g": "K01-K08 pass",
        "providerOnUpdate": true,
        "shizuku": "not_tested",
        "phoneWidgets": "not_tested"
      },
      "evidence": [
        "docs/m0/evidence/item06-widgets.md",
        "docs/m0/evidence/api31g/selftest-results.json",
        "docs/m0/evidence/api31g/P-checks-results.json"
      ]
    },
    "7": {
      "title": "material3 1.5.0-alpha25 运行验证",
      "conclusion": "material3 1.5.0-alpha25 + Compose 1.12.1 在 API 23/28/31/34/36 上均可运行 MaterialExpressiveTheme 与 MotionScheme，无崩溃；APK 内版本由 S04 确认。MaterialKolor 5.0.1 的 minSdk 21 可用，但会拉入 JetBrains Compose material3 1.10.0-alpha05，与锁定版本冲突；按 PLAN 直接用 MCU（minSdk 21，仅 stdlib/poko）。",
      "data": {
        "material3": "1.5.0-alpha25",
        "compose": "1.12.1",
        "minSdk": 23,
        "coldStartMs": {"api23": 875, "api28": 1818, "api31g": 1615, "api34g": 1825, "api36": 7313},
        "materialKolor": {"version": "5.0.1", "minSdk": 21, "conflict": "JetBrains Compose material3 1.10.0-alpha05"},
        "mcu": {"version": "6.0.0", "minSdk": 21, "deps": ["kotlin-stdlib", "poko-annotations"]}
      },
      "evidence": [
        "docs/m0/evidence/item07-material3.md",
        "docs/m0/evidence/api31g/spike-log-full.txt"
      ]
    },
    "8": {
      "title": "系列应用直连联调",
      "conclusion": "夹具 series 的 LAUNCHER_BRIDGE 直连在 api31g 通过（K08，含证书固定与 hello/init/approve/hide）。真实 myBV 1.0.0.r1119、myDV 2.1.1、mytv-android 3.0.0.2806 的 APK 都没有导出 LAUNCHER_BRIDGE Provider，无法与它们端到端联调；按 AGENTS.md 不修改这三个应用，需在系列应用侧补 Provider。",
      "data": {
        "fixtureBridge": "pass",
        "realApks": {
          "myBV": "no LAUNCHER_BRIDGE provider",
          "mydv": "no LAUNCHER_BRIDGE provider",
          "mytv-android": "no LAUNCHER_BRIDGE provider"
        }
      },
      "evidence": [
        "docs/m0/evidence/item08-series.md",
        "docs/m0/evidence/api31g/selftest-results.json"
      ]
    },
    "9": {
      "title": "儿童模式的执行手段",
      "conclusion": "Android 6/9 上后台拉起锁屏无需豁免即可成功；Android 12/14/16 上无豁免会被 Abort，授予 SYSTEM_ALERT_WINDOW appop 后成功。HOME 角色/默认桌面在 Google TV/ATV 模拟器上不生效（系统桌面被钉住），不能作为豁免来源。standard 变体的儿童模式必须依赖悬浮窗 appop；目标固件行为留待真机。",
      "data": {
        "devices": {
          "api23": {"noExemption": "allowed", "overlay": "not_tested", "homeRole": "unavailable"},
          "api28": {"noExemption": "allowed", "overlay": "not_tested", "homeRole": "no effect"},
          "api31g": {"noExemption": "blocked", "overlay": "allowed", "homeRole": "blocked"},
          "api34g": {"noExemption": "blocked", "overlay": "allowed", "homeRole": "blocked"},
          "api36": {"noExemption": "blocked", "overlay": "allowed", "homeRole": "blocked"}
        }
      },
      "evidence": [
        "docs/m0/evidence/item09-kids.md",
        "docs/m0/evidence/api31g/P-checks-results.json",
        "docs/m0/evidence/api34g/P-checks-results.json",
        "docs/m0/evidence/api36/P-checks-results.json"
      ]
    },
    "10": {
      "title": "HOME 兼容",
      "conclusion": "五台模拟器上 cmd package set-home-activity 都返回 Success 但不改变实际 HOME；API 28 没有 cmd role 服务，API 31/34/36 可执行 add-role-holder 但 HOME 键仍启动系统桌面。api28 上停用系统桌面后 set-home-activity 才生效。COMMON_HOME/HOME.CC/TCL meta-data 在模拟器上无效果。该事实会让验收工具的 set_home 在 API>=24 上失败，M1 前必须由用户裁决。",
      "data": {
        "devices": {
          "api23": {"setHome": "cmd unavailable", "role": "unavailable", "homeKey": "system launcher"},
          "api28": {"setHome": "Success but no effect", "role": "service unavailable", "homeKey": "tvlauncher"},
          "api31g": {"setHome": "Success but no effect", "role": "available, no effect", "homeKey": "launcherx"},
          "api34g": {"setHome": "Success but no effect", "role": "available, no effect", "homeKey": "launcherx"},
          "api36": {"setHome": "Success but no effect", "role": "available, no effect", "homeKey": "tvlauncher"}
        },
        "workaroundVerified": "pm disable-user com.google.android.tvlauncher then set-home-activity works (api28)"
      },
      "evidence": [
        "docs/m0/evidence/item10-home.md",
        "docs/m0/evidence/api28/P01-handlers.json",
        "docs/m0/evidence/api31g/P01-handlers.json",
        "docs/m0/evidence/api36/P01-handlers.json"
      ]
    },
    "11": {
      "title": "IP 推测服务的使用条款",
      "conclusion": "ipinfo.io 现在必须带 API token；免费 Lite 只有国家级数据，城市级需要付费 Core；无 token 的 https://ipinfo.io/json 实测返回 HTTP 429，条款/AUP 也禁止未授权自动化访问。设计稿的“无密钥免费城市级 IP 推测”无法成立，M3 前需要用户在付费 token、换服务商或取消 IP 推测之间裁决（建议写 ADR）。",
      "data": {
        "provider": "ipinfo.io",
        "tokenRequired": true,
        "freeTier": "country-level only, unlimited",
        "cityLevelPlan": "Core $26/month",
        "tokenlessStatus": 429,
        "aup": "unauthorized automated access prohibited",
        "decision": "ADR required before M3"
      },
      "evidence": [
        "docs/m0/evidence/item11-ipinfo.md"
      ]
    },
    "12": {
      "title": "文件与安装的系统入口",
      "conclusion": "所有文件访问页在 API 34/36 的电视设置中存在，API 23/28/31 没有；安装未知应用页从 API 26 起存在，API 23 需要全局 secure 设置；DocumentsUI 在电视镜像上不可用，目录授权无法用遥控器完成。PackageInstaller 确认界面在五台设备上都能用遥控器完成安装与取消。api34g 的可移除 vfat 卷在 all-files 授权后才能写，其他设备没有可移除卷，U 盘需真机确认。",
      "data": {
        "settingsPages": {
          "api23": {"allFiles": false, "unknownSources": false, "documentsUi": false},

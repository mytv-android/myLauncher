<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wbg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="8dp">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/w_text"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/w_prev"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/wbtn"
        android:clickable="true"
        android:contentDescription="prev"
        android:focusable="true"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_previous" />

    <ImageView
        android:id="@+id/w_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/wbtn"
        android:clickable="true"
        android:contentDescription="play"
        android:focusable="true"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_play" />

    <ImageView
        android:id="@+id/w_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/wbtn"
        android:clickable="true"
        android:contentDescription="next"
        android:focusable="true"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_next" />
</LinearLayout>

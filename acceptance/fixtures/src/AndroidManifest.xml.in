<?xml version="1.0" encoding="utf-8"?>
<!-- Template: build.py replaces @PKG@ and the @...@ blocks per fixture. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="@PKG@"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.app_widgets" android:required="false" />

    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
@PERMISSIONS@
    <queries>
        <intent>
            <action android:name="android.media.tv.action.REQUEST_CHANNEL_BROWSABLE" />
        </intent>
        <provider android:authorities="android.media.tv" />
@QUERIES@
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name="com.github.mytv.mlfixture.LauncherActivity"
            android:banner="@drawable/banner"
            android:exported="true"
            android:launchMode="singleTask">
@LAUNCHER_FILTER@
        </activity>

        <receiver
            android:name="com.github.mytv.mlfixture.CmdReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <provider
            android:name="com.github.mytv.mlfixture.LogProvider"
            android:authorities="@PKG@.log"
            android:exported="true"
            android:readPermission="android.permission.DUMP"
            android:writePermission="android.permission.DUMP" />

        <provider
            android:name="com.github.mytv.mlfixture.ArtProvider"
            android:authorities="@PKG@.art"
            android:exported="true" />

        <activity
            android:name="com.github.mytv.mlfixture.RequestBrowsableActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name="com.github.mytv.mlfixture.PinWidgetActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name="com.github.mytv.mlfixture.ClickReceiver"
            android:exported="false" />

        <receiver
            android:name="com.github.mytv.mlfixture.PinResultReceiver"
            android:exported="false" />
@COMPONENTS@
    </application>
</manifest>
